# =================================================================
# Meet2Action AI — Environment Variables
# =================================================================

# --- Frontend Environment Variables (.env / Vercel Settings) ---
# Set VITE_API_URL to your backend URL (e.g., https://YOUR-BACKEND-URL or empty if using relative /api)
VITE_API_URL=https://YOUR-BACKEND-URL

# --- Backend Environment Variables (.env / Server Settings) ---
# Production Frontend URL for dynamic CORS permissions:
FRONTEND_URL=https://YOUR-FRONTEND-URL

# Server Port & Host
PORT=8000
HOST=0.0.0.0

# Database Connection (SQLite default, or PostgreSQL)
DATABASE_URL=sqlite:///./meetings.db

# AI Provider Configuration ('demo', 'gemini', or 'openai')
# Default 'demo' works completely offline with zero API keys required
LLM_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=
