# =================================================================
# Meet2Action AI — Production Environment Variables Reference
# =================================================================

# Database Connection (Persistent Storage)
# Local SQLite fallback:
DATABASE_URL=sqlite:///./meetings.db
# Cloud PostgreSQL (Render / Supabase / Neon / Railway):
# DATABASE_URL=postgresql://username:password@ep-host.region.provider.com/meet2action_db?sslmode=require

# AI / LLM Provider Configuration
# Options:
#   'demo'   - Built-in heuristic NLP engine (instant, zero cost, no external API keys needed)
#   'gemini' - Google Gemini 1.5 Flash
#   'openai' - OpenAI GPT-4o-mini
LLM_PROVIDER=demo

# API Keys (Only required if LLM_PROVIDER is 'gemini' or 'openai')
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=https://meet2action.in,https://www.meet2action.in

# Frontend Environment Variable
# When deployed together on custom domain meet2action.in:
VITE_API_URL=https://meet2action.in/api
# Or if using separate backend URL (e.g. on Render):
# VITE_API_URL=https://meet2action-backend.onrender.com/api
