# Backend Environment Variables
DATABASE_URL=sqlite:///./meetings.db

# AI / LLM Configuration
# Options: 'demo' (zero-config heuristic & NLP rule-based, no API key needed),
#          'gemini' (uses Google Gemini 1.5 Flash),
#          'openai' (uses GPT-4o-mini)
LLM_PROVIDER=demo

# Provide your API key if LLM_PROVIDER is 'gemini' or 'openai'
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1
