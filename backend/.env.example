# Backend Environment Variables
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./meetings.db

# Production Frontend URL for CORS (e.g., https://hackathon-henna-ten.vercel.app or custom domain)
FRONTEND_URL=https://YOUR-FRONTEND-URL
CORS_ORIGINS=https://YOUR-FRONTEND-URL

# Optional AI Providers (defaults to built-in local zero-dependency NLP engine)
LLM_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=
